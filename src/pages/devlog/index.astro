---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site.js";

const posts = (await getCollection("devlog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const entries = posts.map((post, index) => ({
  post,
  logNumber: posts.length - index,
}));

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Layout
  title={`Devlog — ${site.name}`}
  description="Lecture notes, project progress, and reflections from Tanvi Shashikanth's engineering degree."
>
  <div class="shell page">
    <aside class="rail" aria-label="On this page">
      <span class="rail-title">Devlog</span>
      <ul class="rail-list">
        <li><a href="#entries" data-rail-link>01 Entries</a></li>
      </ul>
      <p class="rail-note">
        {posts.length}
        {posts.length === 1 ? " entry" : " entries"} so far
      </p>
    </aside>

    <section id="entries" class="section">
      <p class="eyebrow">Log</p>
      <h1 class="display">Devlog</h1>
      <p class="lede">
        Lecture notes, project progress, and reflections — a running record of
        my college journey.
      </p>

      <div class="log-list">
        {
          entries.length > 0 ? (
            entries.map(({ post, logNumber }) => (
              <a class="log-entry" href={`/devlog/${post.id}`}>
                <div class="log-meta">
                  <span class="log-number">
                    LOG {String(logNumber).padStart(3, "0")}
                  </span>
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                </div>
                <div class="log-body">
                  <h2 class="display">{post.data.title}</h2>
                  <p>{post.data.summary}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <ul class="log-tags">
                      {post.data.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </a>
            ))
          ) : (
            <p class="log-empty">
              No Log entries yet. The first one is being written.
            </p>
          )
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  .log-list {
    display: flex;
    flex-direction: column;
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .log-entry {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.25rem 2rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .log-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.35rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .log-number {
    color: var(--lilac);
  }

  .log-body h2 {
    font-size: var(--step-2);
  }

  .log-entry:hover h2 {
    color: var(--lilac);
  }

  .log-body p {
    max-width: 58ch;
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .log-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .log-tags li {
    padding: 0.15rem 0.45rem;
    background: var(--lilac-soft);
    border-radius: 999px;
    color: var(--lilac);
  }

  .log-empty {
    padding-block: 1.5rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .log-entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .log-meta {
      flex-direction: row;
      gap: 1rem;
      padding-top: 0;
    }
  }
</style>
