---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { site } from "../../data/site.js";

export async function getStaticPaths() {
  const posts = await getCollection("devlog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const ordered = (await getCollection("devlog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const logNumber = ordered.length - ordered.findIndex((p) => p.id === post.id);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Layout
  title={`${post.data.title} — Devlog — ${site.name}`}
  description={post.data.summary}
>
  <div class="shell page">
    <aside class="rail" aria-label="Entry details">
      <a class="rail-back" href="/devlog">← All entries</a>
      <span class="rail-title">
        Log {String(logNumber).padStart(3, "0")}
      </span>
      <ul class="rail-meta">
        <li>
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
        </li>
        {post.data.tags &&
          post.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </aside>

    <article>
      <p class="eyebrow">
        Devlog · Log {String(logNumber).padStart(3, "0")}
      </p>
      <h1 class="display entry-title">{post.data.title}</h1>
      <p class="entry-summary">{post.data.summary}</p>

      <div class="prose">
        <Content />
      </div>

      <a class="back-link text-link" href="/devlog">
        ← Back to the Devlog
      </a>
    </article>
  </div>
</Layout>

<style>
  .rail-back {
    display: inline-block;
    margin-bottom: 1.25rem;
    color: var(--lilac);
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .rail-back:hover {
    color: var(--ink);
  }

  .rail-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem 0 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry-title {
    margin-top: 0.5rem;
    font-size: var(--step-4);
  }

  .entry-summary {
    max-width: 52ch;
    margin-bottom: 2.5rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .back-link {
    display: inline-block;
    margin-top: 3rem;
  }
</style>
