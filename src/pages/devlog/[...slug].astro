---
import Layout from "../../layouts/Layout.astro";
import Rail from "../../components/Rail.astro";
import { getCollection, render } from "astro:content";
import { site } from "../../data/site.js";
import { formatDate } from "../../lib/dates.js";
import { numberLogEntries } from "../../lib/devlog.js";

export async function getStaticPaths() {
  const posts = await getCollection("devlog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const logNumber =
  numberLogEntries(await getCollection("devlog")).find(
    (entry) => entry.post.id === post.id
  )?.logNumber ?? 0;
---

<Layout
  title={`${post.data.title} — Devlog — ${site.name}`}
  description={post.data.summary}
>
  <div class="shell page">
    <Rail
      label={`Log ${String(logNumber).padStart(3, "0")}`}
      items={[{ href: "/devlog", label: "← All entries" }]}
      meta={[formatDate(post.data.date, "long"), ...(post.data.tags ?? [])]}
      ariaLabel="Entry details"
    />

    <article>
      <p class="eyebrow">
        Devlog · Log {String(logNumber).padStart(3, "0")}
      </p>
      <h1 class="display entry-title">{post.data.title}</h1>
      <p class="entry-summary">{post.data.summary}</p>

      <div class="prose">
        <Content />
      </div>

      <a class="back-link text-link" href="/devlog">
        ← Back to the Devlog
      </a>
    </article>
  </div>
</Layout>

<style>
  .entry-title {
    margin-top: 0.5rem;
    font-size: var(--step-4);
  }

  .entry-summary {
    max-width: 52ch;
    margin-bottom: 2.5rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .back-link {
    display: inline-block;
    margin-top: 3rem;
  }
</style>
