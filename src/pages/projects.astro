---
import Layout from "../layouts/Layout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects.js";
import { site } from "../data/site.js";
---

<Layout
  title={`Projects — ${site.name}`}
  description="Selected Projects by Tanvi Shashikanth, an Electronics & Computer Engineering student at BITS Goa."
>
  <div class="shell page">
    <aside class="rail" aria-label="On this page">
      <span class="rail-title">Projects</span>
      <ul class="rail-list">
        <li><a href="#all-projects" data-rail-link>01 Selected</a></li>
      </ul>
      <p class="rail-note">
        Placeholder rows stay marked until the work is real.
      </p>
    </aside>

    <section id="all-projects" class="section">
      <p class="eyebrow">Work</p>
      <h1 class="display">Projects</h1>
      <p class="lede">
        A record of things I build while learning software and electronics.
        Each row names the stack and, when it exists, the way to see it.
      </p>

      <div class="project-list">
        {
          projects.map((project, index) => (
            <ProjectRow {...project} index={index + 1} />
          ))
        }
      </div>
    </section>
  </div>
</Layout>
