---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// TODO: Replace these with your real info
const socials = {
  github: "https://github.com/your-username",
  linkedin: "https://www.linkedin.com/in/tanvi-shashikanth-112510421/",
  email: "tanvishashikanth@gmail.com",
};
const resumeLink = "/resume/resume.pdf"; // drop your resume PDF into public/resume/

const posts = (await getCollection('devlog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---
<Layout title="Tanvi | Home">
  <div class="home-grid">
    <section class="hero">
      <h1 class="headline">
        <span class="word">Hi,</span>
        <span class="word">I'm</span>
        <span class="word">Tanvi</span>
        <span class="wave" aria-hidden="true"></span>
      </h1>
      <p class="tagline">
        Electronics & Computer Engineering student, building things at the
        intersection of hardware and software.
      </p>

      <p class="bio">
        I'm currently studying Electronics and Computer Engineering, and I use
        this space to track projects I'm building, things I'm learning, and
        reflections along the way.
        
      </p>

      <div class="cta-group">
        <a href={resumeLink} class="btn btn-primary" target="_blank">
          View Resume
        </a>
        <a href="/projects" class="btn btn-secondary">See My Projects</a>
      </div>

      <div class="socials">
        <a href={socials.github} target="_blank" rel="noopener">GitHub</a>
        <a href={socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>

      <p class="contact">Contact me at <a href={`mailto:${socials.email}`}>{socials.email}</a>.</p>
    </section>

    <aside class="latest-blogs">
      <h2>Latest from the Blog</h2>
      <div class="blogs-body">
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/devlog/${post.id}`}>{post.data.title}</a>
              <span class="post-date">
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </span>
            </li>
          ))}
        </ul>
        <a href="/devlog" class="all-link">Read all posts →</a>
      </div>
    </aside>
  </div>

  <style>
    .home-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    .latest-blogs h2 {
      font-size: 1.25rem;
      color: var(--color-bg);
      margin: 0;
      padding: 1rem 1.5rem;
      background: var(--color-accent);
      font-weight: 700;
      letter-spacing: 0.02em;
      border-radius: 10px 10px 0 0;
    }
    .blogs-body {
      background: var(--color-surface);
      padding: 1.25rem 1.5rem 1.25rem;
      border-radius: 0 0 10px 10px;
    }
    .latest-blogs ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin: 0 0 1.25rem;
      padding: 0;
    }
    .latest-blogs li {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .latest-blogs a[href^="/devlog/"] {
      color: var(--color-text);
      text-decoration: none;
      font-weight: 600;
    }
    .latest-blogs a[href^="/devlog/"]:hover {
      color: var(--color-accent-light);
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
    }
    .post-date {
      font-size: 0.8rem;
      color: var(--color-text-muted);
    }
    .all-link {
      color: var(--color-accent);
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9rem;
    }
    .all-link:hover {
      color: var(--color-accent-light);
    }
    @media (min-width: 860px) {
      .home-grid {
        grid-template-columns: 1fr 180px;
        gap: 1rem;
      }
      .latest-blogs {
        margin-top: 5rem;
        margin-right: calc((100vw - 800px) / -2 + 1rem);
      }
    }
    .hero {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    h1 {
      font-size: 2.25rem;
    }
    .headline {
      display: flex;
      gap: 0.32ch;
    }
    .word {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      animation: word-reveal 0.55s ease-out forwards;
      color: #f4efe6;
    }
    .word:nth-child(1) { animation-delay: 1.1s; }
    .word:nth-child(2) { animation-delay: 1.3s; }
    .word:nth-child(3) { animation-delay: 1.5s; }
    .wave {
      display: inline-block;
      margin-left: 0.1em;
      opacity: 0;
      animation:
        wave-in 0.4s ease-out 1.72s forwards,
        wave 0.9s ease-in-out 2.2s 1;
      transform-origin: 70% 80%;
    }
    .wave::before {
      content: "\1F44B";
    }
    @keyframes word-reveal {
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes wave-in {
      to { opacity: 1; }
    }
    @keyframes wave {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(20deg); }
      50% { transform: rotate(-10deg); }
      75% { transform: rotate(15deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .word, .wave {
        animation: none;
        opacity: 1;
        transform: none;
      }
    }
    .tagline {
      font-size: 1.15rem;
      color: var(--color-text-muted);
      font-weight: 500;
    }
    .bio {
      max-width: 60ch;
      color: var(--color-text);
    }
    .cta-group {
      display: flex;
      gap: 1rem;
      margin-top: 0.5rem;
    }
    .btn {
      padding: 0.6rem 1.2rem;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
    }
    .btn-primary {
      background: var(--color-accent);
      color: var(--color-text-on-accent);
    }
    .btn-primary:hover {
      background: var(--color-accent-light);
    }
    .btn-secondary {
      background: transparent;
      color: var(--color-accent);
      border: 1.5px solid var(--color-accent);
    }
    .btn-secondary:hover {
      background: rgba(245, 197, 66, 0.12);
    }
    .socials {
      display: flex;
      gap: 1.25rem;
      margin-top: 1rem;
    }
    .contact {
      margin-top: 0.5rem;
      color: var(--color-text);
    }
    .contact a {
      color: var(--color-text);
      text-decoration: none;
      font-weight: 600;
    }
    .contact a:hover {
      color: var(--color-accent-light);
      text-decoration: underline;
    }
    .socials a {
      color: var(--color-text);
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }
    .socials a:hover {
      color: var(--color-accent-light);
      border-bottom-color: var(--color-accent);
    }
  </style>
</Layout>
