---
import Layout from "../layouts/Layout.astro";
import Rail from "../components/Rail.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { getCollection } from "astro:content";
import { projects } from "../data/projects.js";
import { site } from "../data/site.js";
import { formatDate } from "../lib/dates.js";
import { sortLogEntries } from "../lib/devlog.js";

const latest = sortLogEntries(await getCollection("devlog")).slice(0, 2);

const featured = projects.filter((project) => project.featured);
const selected = featured.length > 0 ? featured : projects.slice(0, 2);
---

<Layout
  title={`${site.name} — Electronics & Computer Engineering`}
  description="Tanvi Shashikanth is an Electronics & Computer Engineering student at BITS Goa. Projects, notes, and a public Devlog."
>
  <div class="shell page">
    <Rail
      label="Index"
      items={[
        { href: "#intro", label: "01 Intro" },
        { href: "#work", label: "02 Projects" },
        { href: "#devlog", label: "03 Devlog" },
      ]}
      note="BITS Goa · ECE, second year"
    />

    <div>
      <section id="intro" class="section hero">
        <div class="hero-copy">
          <p class="eyebrow">
            Electronics &amp; Computer Engineering · BITS Goa
          </p>
          <h1 class="display">
            I build where <em>hardware</em> meets <em>software</em>.
          </h1>
          <p class="hero-bio">
            I'm Tanvi. I study electronics and computing, and I use this space
            to keep the Projects I'm building and the things I'm learning in
            public.
          </p>
          <div class="actions">
            <a
              class="button"
              href={site.resume}
              target="_blank"
              rel="noopener"
            >
              View resume
            </a>
            <a class="text-link" href="/projects">See Projects</a>
          </div>
        </div>

        <aside class="bench" aria-label="Current bench">
          <p class="bench-title">Current bench</p>
          <dl>
            <div class="bench-row">
              <dt>Studying</dt>
              <span class="leader" aria-hidden="true"></span>
              <dd>ECE, BITS Goa</dd>
            </div>
            <div class="bench-row">
              <dt>Building</dt>
              <span class="leader" aria-hidden="true"></span>
              <dd>This site, then my first Project</dd>
            </div>
            <div class="bench-row">
              <dt>Learning</dt>
              <span class="leader" aria-hidden="true"></span>
              <dd>Astro, deployment, embedded fundamentals</dd>
            </div>
            <div class="bench-row">
              <dt>Next</dt>
              <span class="leader" aria-hidden="true"></span>
              <dd>My first real Project</dd>
            </div>
          </dl>
        </aside>
      </section>

      <section id="work" class="section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Selected Projects</p>
            <h2 class="display">Projects</h2>
          </div>
          <a class="text-link" href="/projects">All projects</a>
        </div>

        <div class="project-list">
          {
            selected.map((project, index) => (
              <ProjectRow {...project} index={index + 1} />
            ))
          }
        </div>
      </section>

      <section id="devlog" class="section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Latest writing</p>
            <h2 class="display">From the Devlog</h2>
          </div>
          <a class="text-link" href="/devlog">All entries</a>
        </div>

        <div class="latest-list">
          {
            latest.length > 0 ? (
              latest.map((post) => (
                <a class="latest-entry" href={`/devlog/${post.id}`}>
                  <span class="latest-date">
                    {formatDate(post.data.date)}
                  </span>
                  <span class="latest-title">{post.data.title}</span>
                  <span class="latest-summary">{post.data.summary}</span>
                </a>
              ))
            ) : (
              <p class="latest-empty">
                No Log entries yet. The first one is being written.
              </p>
            )
          }
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    padding-top: 0.5rem;
  }

  .hero h1 {
    font-size: var(--step-5);
  }

  .hero h1 em {
    color: var(--lilac);
    font-style: italic;
  }

  .hero .eyebrow {
    margin-bottom: 1rem;
  }

  .hero-bio {
    max-width: 46ch;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .latest-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }

  .latest-entry {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.35rem 1.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .latest-date {
    padding-top: 0.35rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .latest-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .latest-entry:hover .latest-title {
    color: var(--lilac);
  }

  .latest-summary {
    grid-column: 2;
    max-width: 56ch;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .latest-empty {
    padding-block: 1.5rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .bench {
      max-width: 32rem;
    }
  }

  @media (max-width: 640px) {
    .latest-entry {
      grid-template-columns: 1fr;
    }

    .latest-summary {
      grid-column: 1;
    }
  }
</style>
