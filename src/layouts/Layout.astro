---
import "../styles/global.css";
import { site } from "../data/site.js";

const {
  title = `${site.name} — Electronics & Computer Engineering`,
  description = "Personal site and Devlog of Tanvi Shashikanth, an Electronics & Computer Engineering student at BITS Goa.",
} = Astro.props;

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  path === href || (href !== "/" && path.startsWith(`${href}/`));
const year = new Date().getFullYear();

const fontHref =
  "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4eff4" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/">
          {site.name}<span class="monogram" aria-hidden="true">TS</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a
            href="/projects"
            aria-current={isCurrent("/projects") ? "page" : undefined}
          >
            Projects
          </a>
          <a
            href="/devlog"
            aria-current={isCurrent("/devlog") ? "page" : undefined}
          >
            Devlog
          </a>
          <a
            class="nav-resume"
            href={site.resume}
            target="_blank"
            rel="noopener"
          >
            Resume
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <p class="footer-name">{site.name}</p>
          <p class="footer-meta">
            Electronics &amp; Computer Engineering · BITS Goa
          </p>
          <p class="footer-meta">&copy; {year} {site.name}</p>
        </div>
        <nav class="footer-links" aria-label="Elsewhere">
          <a href={`mailto:${site.email}`}>Email</a>
          {
            site.github && (
              <a href={site.github} target="_blank" rel="noopener">
                GitHub
              </a>
            )
          }
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
