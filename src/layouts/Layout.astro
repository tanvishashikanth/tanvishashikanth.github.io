---
const { title = "Tanvi | Developer Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal developer portfolio and dev log" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container">
        <a href="/" class="logo">Tanvi</a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/projects">Projects</a>
          <a href="/devlog">Blog</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Tanvi. Built with Astro.</p>
    </footer>

    <style is:global>
  :root {
    /* Purple & gold theme - all pairings meet WCAG AA (>= 4.5:1 body text, >= 3:1 UI) */
    --color-bg: #241b35;              /* deep aubergine page background */
    --color-surface: #2f2447;         /* cards, header */
    --color-surface-raised: #3a2d58;  /* hover / raised surfaces */
    --color-accent: #f5c542;          /* royal gold - primary actions, highlights (10:1 on bg) */
    --color-accent-light: #ffd76a;    /* brighter gold for hovers */
    --color-violet: #b79df2;          /* readable violet for secondary accents (7:1 on bg) */
    --color-text: #efeaf7;            /* near-white lavender text (~14:1 on bg) */
    --color-text-muted: #c1b1d8;      /* secondary text (~8.8:1 on bg) */
    --color-border: #453564;
    --color-text-on-accent: #241b35;  /* dark purple text on gold fills (10:1) */
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  body {
    font-family: "Lora", Georgia, "Times New Roman", serif;
    line-height: 1.6;
    color: var(--color-text);
    background: var(--color-bg);
  }
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: 70vh;
  }
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }  .nav-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    color: var(--color-accent);
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    margin-right: calc((100vw - 800px) / -4 + 1rem);
  }
  .nav-links a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .nav-links a:hover {
    color: var(--color-accent-light);
  }
  .site-footer {
    text-align: center;
    padding: 2rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-border);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
  </body>
</html>