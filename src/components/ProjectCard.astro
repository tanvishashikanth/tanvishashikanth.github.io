---
const { title, description, techStack, githubUrl, liveUrl } = Astro.props;
---
<div class="project-card">
  <h3>{title}</h3>
  <p class="description">{description}</p>

  <div class="tech-stack">
    {techStack.map((tech) => <span class="tech-badge">{tech}</span>)}
  </div>

  <div class="links">
    {githubUrl && (
      <a href={githubUrl} target="_blank" rel="noopener">GitHub →</a>
    )}
    {liveUrl && (
      <a href={liveUrl} target="_blank" rel="noopener">Live Demo →</a>
    )}
  </div>
</div>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.5rem;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  h3 {
    font-size: 1.25rem;
    color: var(--color-accent-light);
  }
  .description {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tech-badge {
    background: rgba(183, 157, 242, 0.15);
    color: var(--color-violet);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }
  .links {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
  }
  .links a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .links a:hover {
    color: var(--color-accent-light);
    text-decoration: underline;
  }
</style>