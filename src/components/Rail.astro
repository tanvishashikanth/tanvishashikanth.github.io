---
interface RailItem {
  href: string;
  label: string;
}

interface Props {
  label: string;
  items: RailItem[];
  note?: string;
  meta?: string[];
  ariaLabel?: string;
}

const { label, items, note, meta = [], ariaLabel = "On this page" } =
  Astro.props;
---

<button
  class="rail-toggle"
  type="button"
  aria-label="Page index"
  aria-expanded="false"
  aria-controls="rail-panel"
  data-rail-toggle
>
  Index
</button>

<div
  class="rail-backdrop"
  aria-hidden="true"
  data-rail-backdrop
></div>

<aside
  class="rail"
  id="rail-panel"
  aria-label={ariaLabel}
  data-rail-panel
  tabindex="-1"
>
  <button
    class="rail-close"
    type="button"
    aria-label="Close page index"
    data-rail-close
  >
    Close
  </button>
  <span class="rail-title">{label}</span>
  <ul class="rail-list">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            data-rail-link={item.href.startsWith("#") ? true : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  {
    meta.length > 0 && (
      <ul class="rail-meta">
        {meta.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
  <slot />
  {note && <p class="rail-note">{note}</p>}
</aside>

<script>
  const panel = document.querySelector<HTMLElement>("[data-rail-panel]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-rail-toggle]");
  const closeButton = document.querySelector<HTMLButtonElement>(
    "[data-rail-close]"
  );
  const backdrop = document.querySelector<HTMLElement>("[data-rail-backdrop]");

  if (panel && toggle && backdrop) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle("is-open", open);
      backdrop.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("rail-open", open);
    };

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    toggle.addEventListener("click", () => {
      const open = !isOpen();
      setOpen(open);
      if (open) requestAnimationFrame(() => closeButton?.focus());
    });

    const close = () => {
      if (!isOpen()) return;
      setOpen(false);
      toggle.focus();
    };

    closeButton?.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") close();
    });
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });

    window
      .matchMedia("(min-width: 821px)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }

  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-rail-link]")
  );
  const sections = links
    .map((link) =>
      document.querySelector<HTMLElement>(link.getAttribute("href") ?? "")
    )
    .filter((section): section is HTMLElement => section !== null);

  if ("IntersectionObserver" in window && sections.length > 0) {
    const setActive = (id: string) => {
      links.forEach((link) => {
        link.classList.toggle(
          "is-active",
          link.getAttribute("href") === `#${id}`
        );
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: "-20% 0px -65% 0px", threshold: 0 }
    );

    sections.forEach((section) => observer.observe(section));
    setActive(sections[0].id);
  }
</script>
