---
interface Props {
  title: string;
  description: string;
  techStack?: string[];
  githubUrl?: string;
  liveUrl?: string;
  status?: "placeholder" | "in progress" | "shipped" | string;
  index: number;
}

const {
  title,
  description,
  techStack = [],
  githubUrl = "",
  liveUrl = "",
  status = "in progress",
  index,
} = Astro.props;

const number = String(index).padStart(2, "0");
const statusLabels: Record<string, string> = {
  placeholder: "Placeholder",
  "in progress": "In progress",
  shipped: "Shipped",
};
const statusLabel = statusLabels[status] ?? status;
const statusClass = `status-${status.replace(/\s+/g, "-")}`;

const isRealUrl = (url: string) =>
  Boolean(url) && !/your-username|example\.com/.test(url);
const github = isRealUrl(githubUrl) ? githubUrl : "";
const live = isRealUrl(liveUrl) ? liveUrl : "";
const hasLinks = Boolean(github || live);
---

<article class="project-row">
  <span class="project-index" aria-hidden="true">{number}</span>
  <div class="project-body">
    <div class="project-head">
      <h3 class="display">{title}</h3>
      <span class={`status ${statusClass}`}>{statusLabel}</span>
    </div>
    <p class="project-description">{description}</p>
    <div class="project-foot">
      {
        techStack.length > 0 && (
          <ul class="stack">
            {techStack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        )
      }
      {
        hasLinks ? (
          <div class="project-links">
            {github && (
              <a class="text-link" href={github} target="_blank" rel="noopener">
                GitHub
              </a>
            )}
            {live && (
              <a class="text-link" href={live} target="_blank" rel="noopener">
                Live
              </a>
            )}
          </div>
        ) : (
          <span class="links-pending">Links coming soon</span>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .project-row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .project-index {
    padding-top: 0.55rem;
    color: var(--lilac);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-head h3 {
    font-size: var(--step-2);
  }

  .status {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status-shipped {
    border-color: var(--lilac);
    color: var(--lilac);
  }

  .status-in-progress {
    border-color: var(--ink);
    color: var(--ink);
  }

  .project-description {
    max-width: 58ch;
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .links-pending {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .project-index {
      padding-top: 0;
    }
  }
</style>
